            xmlns:ism="urn:us:gov:ic:ism"
            targetNamespace="urn:us:gov:ic:ism"
            elementFormDefault="qualified"
            attributeFormDefault="qualified">

    <!-- Referenced as optional element (commented out in BSA but schema still imports) -->
