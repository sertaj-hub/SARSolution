    <!-- Attribute groups referenced by BSABatch element -->
    <xsd:attributeGroup name="ISMRootNodeAttributeOptionGroup"/>
    <xsd:attributeGroup name="ResourceNodeAttributeOptionGroup"/>

</xsd:schema>
